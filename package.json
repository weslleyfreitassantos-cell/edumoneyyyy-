{
  "name": "edumanager-pro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "camera-gateway": "node --experimental-strip-types camera-gateway/src/cli.ts",
    "preview": "vite preview",
    "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "lint": "npm run typecheck",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:local": "playwright test --config=e2e/playwright.config.ts",
    "e2e:production-smoke": "playwright test --config=e2e/production-smoke.config.ts",
    "enem:discover": "node --experimental-strip-types tools/enem/discover.ts",
    "enem:download": "node --experimental-strip-types tools/enem/download.ts",
    "enem:parse": "node --experimental-strip-types tools/enem/parse.ts",
    "enem:canonicalize": "node --experimental-strip-types tools/enem/canonicalize.ts",
    "enem:review": "node --experimental-strip-types tools/enem/review-report.ts",
    "enem:second-pass": "node --experimental-strip-types tools/enem/second-pass.ts",
    "enem:dry-run": "node --experimental-strip-types tools/enem/dry-run.ts",
    "enem:import-sql": "node --experimental-strip-types tools/enem/import.ts",
    "enem:ingest": "node --experimental-strip-types tools/enem/ingest.ts",
    "routing:guard": "node scripts/validate-domain-routing.mjs",
    "deploy:worker": "npm run routing:guard && npm run build && npx wrangler deploy",
    "test:full:local": "node scripts/test-full-local.mjs",
    "health:prod": "node scripts/production-health.mjs",
    "adaptive:v4:validate": "node --experimental-strip-types tools/adaptive/compile-v4.ts validate",
    "adaptive:v4:compile": "node --experimental-strip-types tools/adaptive/compile-v4.ts compile",
    "bncc:validate": "node tools/bncc/validate-catalog.mjs && node tools/bncc/validate-coverage.mjs",
    "bncc:coverage": "node tools/bncc/generate-coverage.mjs",
    "bncc:mapping-candidates": "node tools/bncc/map-candidates.mjs",
    "bncc:validate-mapping-candidates": "node tools/bncc/validate-mapping-candidates.mjs",
    "bncc:review-mappings": "node tools/bncc/review-mappings.mjs",
    "bncc:validate-mapping-reviews": "node tools/bncc/validate-mapping-reviews.mjs",
    "bncc:semantic-candidates": "node tools/bncc/expand-semantic-candidates.mjs",
    "bncc:validate-semantic-candidates": "node tools/bncc/validate-semantic-candidates.mjs",
    "bncc:canonical-gaps": "node tools/bncc/cluster-canonical-gaps.mjs",
    "bncc:validate-canonical-gaps": "node tools/bncc/validate-canonical-gaps.mjs",
    "bncc:context-index": "node tools/bncc/build-context-index.mjs",
    "bncc:validate-context-index": "node tools/bncc/validate-context-index.mjs",
    "bncc:canonical-gaps-v8": "node tools/bncc/build-gap-clusters-v8.mjs",
    "bncc:validate-canonical-gaps-v8": "node tools/bncc/validate-gap-clusters-v8.mjs",
    "bncc:proposals-v8": "node tools/bncc/build-proposals-v8.mjs",
    "bncc:review-proposals-v8": "node tools/bncc/review-proposals-v8.mjs",
    "bncc:validate-multimodal-canaries": "node tools/bncc/validate-multimodal-canaries.mjs",
    "bncc:canonical-graph": "node tools/bncc/build-canonical-graph.mjs",
    "bncc:sync-v4-registries": "node tools/bncc/sync-v4-registries.mjs",
    "bncc:content-packages": "node tools/bncc/build-content-packages.mjs",
    "bncc:validate-content-packages": "node tools/bncc/validate-content-packages.mjs",
    "bncc:reconcile-progress": "node tools/bncc/reconcile-progress.mjs",
    "check": "npm run routing:guard && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.2",
    "@tanstack/react-query": "^5.101.2",
    "hls.js": "^1.7.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^29.1.1",
    "pdfjs-dist": "^6.3.289",
    "supabase": "^2.109.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.137.0"
  }
}
