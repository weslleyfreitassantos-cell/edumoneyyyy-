[Unit]
Description=TecEscola production pilot health checks
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
StateDirectory=tecescola-pilot-monitor
StateDirectoryMode=0700
Environment=HOME=/root
Environment=XDG_CONFIG_HOME=/root/.config
ExecStart=/usr/bin/python3 /srv/grupotec/bin/tecescola_pilot_monitor.py
TimeoutStartSec=180
RuntimeMaxSec=180
CPUAccounting=true
MemoryAccounting=true
CPUQuota=25%
MemoryMax=512M
TasksMax=64
Nice=10
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
NoNewPrivileges=true
