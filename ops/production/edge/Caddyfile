tecescola.grupotec.dev.br {
    log {
        output stdout
        format json
    }
    root * /srv/grupotec/web/edumoney/current
    try_files {path} /index.html
    encode gzip
    file_server
    header {
        -Server
        Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Pragma "no-cache"
        Expires "0"
    }
}

