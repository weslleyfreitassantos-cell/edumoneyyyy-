api-edu-vps.grupotec.dev.br {
    log {
        output stdout
        format json
    }

    # Public school-branding assets are versioned by cacheNonce when changed.
    # Cache only this public bucket; Auth, REST, Storage writes, and RPCs remain no-store.
    @institutionBrandingAssets path /storage/v1/object/public/institution-branding/*
    handle @institutionBrandingAssets {
        header {
            -Server
            -Pragma
            -Expires
            >Cache-Control "public, max-age=2592000"
        }
        reverse_proxy 127.0.0.1:18002
    }

    handle {
        header {
            -Server
            Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
            Pragma "no-cache"
            Expires "0"
        }
        reverse_proxy 127.0.0.1:18002
    }
}

