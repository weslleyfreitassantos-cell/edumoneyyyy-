{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "edumoneyyyy",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-17",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },

  // The wildcard serves institution hosts. The reserved marketing host is
  // excluded by a more-specific Cloudflare route with script=null; never add
  // tecescola.grupotec.dev.br/* to this Worker configuration.
  "routes": [
    {
      "pattern": "*.grupotec.dev.br/*",
      "zone_name": "grupotec.dev.br"
    }
  ]
}
